# Backend URL (see server/README.md). Defaults to http://localhost:8787 if unset.
VITE_API_BASE_URL="http://localhost:8787"

# Must match API_KEY in server/.env. See the NOTE in src/lib/api.js — this
# value ships in the built JS bundle and is not a real secret against users
# of the app itself, only against unauthenticated internet traffic.
VITE_API_KEY="change-me-as-well"
