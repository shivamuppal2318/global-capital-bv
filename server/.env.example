PORT=8787

# Public base URL for this API, used to build links embedded in outgoing
# emails (currently just the unsubscribe link). Set this to a real reachable
# URL in any non-local deployment.
APP_BASE_URL="http://localhost:8787"

# Postgres connection string. Matches docker-compose.yml's credentials —
# `docker compose up -d` then this URL works with no changes.
DATABASE_URL="postgresql://crm:crm@localhost:5432/global_capital_crm"

# Encrypts SMTP passwords stored on EmailAccount rows (AES-256-GCM — see
# src/lib/credentialCrypto.js) so multiple mailbox credentials aren't sitting
# in the database as plaintext. Required for any /email-accounts write.
# Losing this key means every stored EmailAccount password becomes
# permanently undecryptable — back it up like any other secret.
ENCRYPTION_KEY="change-me-encryption"

# Redis connection string for the cadence job queue. If unset, the queue/worker
# is skipped and the server runs in "no scheduling" mode (send endpoints still
# work, but delayed follow-ups won't fire). Also provided by docker-compose.yml.
REDIS_URL="redis://localhost:6379"

# "dev" logs emails to the console/activity log instead of sending.
# Set to "smtp" (works today), or "ses"/"postmark" once their SDK calls are
# implemented — both also expose SMTP endpoints "smtp" can hit directly.
EMAIL_PROVIDER="dev"

# --- SMTP (works with any provider's SMTP endpoint, or your own mail relay) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_ADDRESS=""

# Optional DKIM signing (SMTP provider only). All three must be set together
# or none apply. The matching public key must ALSO be published as a DNS TXT
# record at "<selector>._domainkey.<domain>" for this to actually help
# deliverability — signing without that DNS record just adds an unverifiable
# header. Provider dashboards (SES/Postmark/etc.) usually generate this
# keypair + give you the exact DNS record to add.
DKIM_DOMAIN=""
DKIM_SELECTOR=""
DKIM_PRIVATE_KEY=""

# --- Inbound reply watching (IMAP polling) ---
# Watches SMTP_USER's actual mailbox for replies and auto-classifies +
# auto-responds to them (see lib/imapPoller.js, lib/autoRespond.js). Needs
# IMAP_HOST set; reuses SMTP_USER/SMTP_PASS as the mailbox login (same
# account, different protocol). Leave IMAP_HOST blank to disable — the
# server runs fine without it, it just won't notice real inbound replies.
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_POLL_INTERVAL_MS="60000"

# --- SES ---
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_ADDRESS=""

# --- Postmark ---
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_ADDRESS=""

# Shared secret the inbound-email AND bounce webhooks must present (header
# x-webhook-secret) so randoms on the internet can't post fake replies or
# fake bounce reports into the CRM.
INBOUND_WEBHOOK_SECRET="change-me"

# Signs unsubscribe links (see src/lib/unsubscribeToken.js) so a bare lead id
# in the URL can't be guessed/enumerated to unsubscribe arbitrary leads.
# Required — /leads/:id/send(-template) will fail without it.
UNSUBSCRIBE_SECRET="change-me-too"

# Signs NDA-signing links (see src/lib/ndaSignToken.js), same reasoning as
# UNSUBSCRIBE_SECRET but deliberately a different value — an unsubscribe
# link and an NDA-signing link are very different-consequence actions.
# Required — /leads/:id/send-template will fail for the "interested"
# template without it (that template references {{ndaSignUrl}}).
NDA_SIGN_SECRET="change-me-nda"

# Calendly's webhook signing secret (from your Calendly account's webhook
# subscription settings, once you create one pointing at
# https://<your-domain>/webhooks/calendly). Verifies POST /webhooks/calendly
# requests actually came from Calendly — see lib/calendlyWebhookAuth.js.
# Without a real Calendly account this can't be tested against a live
# webhook, only against self-signed test payloads (see the test suite).
CALENDLY_WEBHOOK_SIGNING_KEY="change-me-calendly"

# Signs open/click tracking links embedded in outgoing emails (see
# src/lib/trackingToken.js) — same reasoning as UNSUBSCRIBE_SECRET/NDA_SIGN_SECRET,
# deliberately a different value. Required for any send that includes HTML
# (the pixel/link rewriting call signTrackingToken()).
TRACKING_SECRET="change-me-tracking"

# Simple API key required on every route below except /health, the webhooks
# (which use their own secret), and /unsubscribe (public link, protected by
# UNSUBSCRIBE_SECRET instead). See src/middleware/apiKey.js.
API_KEY="change-me-as-well"

# --- Market intelligence engine (src/lib/marketIntelligence/) ---
# All five of these are unconfigured by default — GET /market-intelligence/status
# reports which ones are on. Endpoint URLs/response shapes for all four
# external services below are written from public docs, NOT verified
# against a live account (none available while building this) — expect to
# adjust the normalize*() function in the matching source file once you
# have a real key and see the actual response.
NEWSAPI_AI_KEY=""
EXA_API_KEY=""
FIRECRAWL_API_KEY=""
APOLLO_API_KEY=""
# Real LLM call (Claude Messages API) for entity/signal-type/relevance
# extraction — see lib/marketIntelligence/aiProcessor.js. The prompt and
# response-parsing are unit-tested against mock responses; the actual
# network call has never run without this key set.
ANTHROPIC_API_KEY=""

# Automatic scheduler (src/lib/marketIntelligence/scheduler.js) — runs the
# pipeline on an interval instead of only via manual POST /market-intelligence/run.
# Only starts if at least one of NEWSAPI_AI_KEY/EXA_API_KEY/FIRECRAWL_API_KEY
# is set; does nothing (not even the first run) if all three are blank.
MARKET_INTELLIGENCE_INTERVAL_MS="21600000"
MARKET_INTELLIGENCE_QUERY="private equity funding acquisition"
# A campaign leads get created under when a signal doesn't match an
# existing one — without this, unmatched signals are recorded and marked
# IGNORED rather than creating a lead with nowhere to belong.
MARKET_INTELLIGENCE_DEFAULT_CAMPAIGN_ID=""
