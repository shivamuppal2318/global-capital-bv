DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_crm?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Get a key from https://console.anthropic.com/ — required for the WhatsApp
# AI chat panel AND the Market Intelligence chat assistant / signal
# processing below (same key, shared across both).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Signs login session tokens (see src/lib/auth.js). Required for every
# authenticated route — generate a real random value for anything beyond
# local dev, e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me"

# Bootstrap admin account, created once by prisma/ensureDefaults.js if no
# admin user exists yet. Leave ADMIN_PASSWORD unset to have a random one
# generated and printed to the console/deploy logs on first run instead.
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD=

# ============================================================================
# Email cold-outreach domain (merged from the `crm` branch)
# ============================================================================

# Public base URL for this API, used to build links embedded in outgoing
# emails (unsubscribe/NDA/tracking links). Set to a real reachable URL in
# any non-local deployment.
APP_BASE_URL="http://localhost:4000"

# Encrypts SMTP passwords stored on EmailAccount rows (AES-256-GCM — see
# src/lib/credentialCrypto.js) so multiple mailbox credentials aren't sitting
# in the database as plaintext. Required for any /api/email-accounts write.
# Losing this key means every stored EmailAccount password becomes
# permanently undecryptable — back it up like any other secret.
ENCRYPTION_KEY="change-me-encryption"

# Redis connection string for the cadence job queue. If unset, the queue/worker
# is skipped and the server runs in "no scheduling" mode (send endpoints still
# work, but delayed follow-ups won't fire). No Redis installed locally (and no
# Docker)? Run `npm run redis:start` (server/scripts/start-local-redis.mjs) —
# same "embedded" approach as db:start for Postgres — and leave it running
# alongside the backend.
REDIS_URL="redis://localhost:6379"

# "dev" logs emails to the console/activity log instead of sending.
# Set to "smtp" (works today), or "ses"/"postmark" once their SDK calls are
# implemented — both also expose SMTP endpoints "smtp" can hit directly.
EMAIL_PROVIDER="dev"

# --- SMTP (works with any provider's SMTP endpoint, or your own mail relay) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_ADDRESS=""

# Optional DKIM signing (SMTP provider only). All three must be set together
# or none apply. The matching public key must ALSO be published as a DNS TXT
# record for this to actually help deliverability.
DKIM_DOMAIN=""
DKIM_SELECTOR=""
DKIM_PRIVATE_KEY=""

# --- Inbound reply watching (IMAP polling) ---
# Watches SMTP_USER's actual mailbox for replies and auto-classifies +
# auto-responds to them (see lib/imapPoller.js, lib/autoRespond.js). Leave
# IMAP_HOST blank to disable.
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_POLL_INTERVAL_MS="60000"

# --- SES ---
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_ADDRESS=""

# --- Postmark ---
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_ADDRESS=""

# Shared secret the inbound-email AND bounce webhooks must present (header
# x-webhook-secret) so randoms on the internet can't post fake replies or
# fake bounce reports into the CRM.
INBOUND_WEBHOOK_SECRET="change-me"

# Signs unsubscribe links (see src/lib/unsubscribeToken.js).
UNSUBSCRIBE_SECRET="change-me-too"

# Signs NDA-signing links (see src/lib/ndaSignToken.js), deliberately a
# different value from UNSUBSCRIBE_SECRET.
NDA_SIGN_SECRET="change-me-nda"

# Signs client-portal invite links (see src/lib/clientPortalToken.js),
# deliberately a different value from the other link-signing secrets above.
CLIENT_PORTAL_SECRET="change-me-portal"

# Calendly's webhook signing secret. Verifies POST /api/webhooks/calendly
# requests actually came from Calendly — see lib/calendlyWebhookAuth.js.
CALENDLY_WEBHOOK_SIGNING_KEY="change-me-calendly"

# Signs open/click tracking links embedded in outgoing emails (see
# src/lib/trackingToken.js), deliberately a different value from the above.
TRACKING_SECRET="change-me-tracking"

# NOTE: no API_KEY var here — the email routes are mounted with no auth
# gate, matching the rest of this app (WhatsApp/Zoom/Meetings/AI chat also
# have none today). middleware/apiKey.js exists and works if/when uniform
# auth gets added later.

# --- Market intelligence engine (src/lib/marketIntelligence/) ---
# Google News RSS needs no key and is always on. The rest report their
# status via GET /api/market-intelligence/status.
NEWSAPI_AI_KEY=""
EXA_API_KEY=""
FIRECRAWL_API_KEY=""
APOLLO_API_KEY=""
# Reuses ANTHROPIC_API_KEY above for signal processing + the chat assistant.

# Automatic scheduler (src/lib/marketIntelligence/scheduler.js) — runs the
# pipeline on an interval instead of only via manual POST /run. Starts as
# soon as the server boots (Google News RSS needs no key, so this is on by
# default); default below is weekly, matching Google News RSS's own
# "when:7d" result scoping so each run only pulls what's new since the last.
MARKET_INTELLIGENCE_INTERVAL_MS="604800000"
MARKET_INTELLIGENCE_QUERY="private equity funding acquisition"
MARKET_INTELLIGENCE_DEFAULT_CAMPAIGN_ID=""
