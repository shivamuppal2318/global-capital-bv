generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationStatus {
  NEW
  ASSIGNED
  REPLIED
  RESOLVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  IN_REVIEW
  REJECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
}

enum SequenceStatus {
  ACTIVE
  PAUSED
}

enum MatchType {
  CONTAINS
  EXACT
}

enum RuleStatus {
  ACTIVE
  PAUSED
}

enum FlowStepType {
  TRIGGER
  MESSAGE
  QUESTION
  CONDITION
  ACTION
}

enum TriggerStatus {
  ACTIVE
  DRAFT
}

enum AgentStatus {
  ONLINE
  AWAY
  OFFLINE
}

// Server-managed secrets that must survive restarts but should never live in
// the repo or a compose file — currently just the JWT signing key, which is
// generated on first boot when JWT_SECRET isn't supplied via the environment.
model AppSecret {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// A real login account (bcrypt-hashed password, JWT auth) — distinct from
// Agent above, which is just a display/assignment label for WhatsApp
// conversations and predates this model having no credentials of its own.
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Module ids (see src/lib/permissions.js) this employee may open. Only
  // consulted for EMPLOYEE — an ADMIN always has every module, so revoking
  // an admin's access means demoting them first.
  permissions String[] @default([])

  // The Zoom user this employee schedules meetings as (must be a licensed
  // user under the account tied to ZoomSettings' Server-to-Server app).
  // Null falls back to ZoomSettings.hostEmail, so meetings keep working for
  // employees no one has assigned a Zoom seat to yet.
  zoomHostEmail String?

  // Personal SMTP mailboxes this employee owns (see EmailAccount.ownerId).
  emailAccounts EmailAccount[]
  passwordResets PasswordResetToken[]
  documents      Document[]
  verifiedDocuments Document[] @relation("DocumentVerifiedBy")
  auditLogs      AuditLog[]
}

// Who did what, when — logins, admin actions (employee/permission changes,
// credential edits), and the higher-stakes MailX actions (campaigns,
// mailboxes, lead deletion). Written by src/lib/auditLog.js, never edited
// or deleted through the app itself; that's what makes it useful as a real
// record instead of just another mutable table.
model AuditLog {
  id     String @id @default(cuid())
  // Kept even if the actor's account is later deleted — an audit trail
  // that goes blank the moment someone is removed defeats its own purpose,
  // so the actor's name/email are snapshotted at write time (actor* below)
  // rather than only ever joined live off User.
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorName  String
  actorEmail String
  // Dot-namespaced (e.g. "campaign.paused", "employee.permissions_updated")
  // so the Admin Panel's filter can match a whole namespace or one exact
  // action.
  action     String
  entityType String?
  entityId   String?
  detail     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

// Single row holding the company-wide "system" mailbox used for
// transactional mail the app sends about itself — password resets and new
// account handoffs. Deliberately separate from EmailAccount, which is for
// outbound sales campaigns: those are per-user and get rotated/paused, and
// password reset delivery must not depend on a salesperson's mailbox.
model SystemEmailSettings {
  id                String   @id @default(cuid())
  smtpHost          String
  smtpPort          Int      @default(587)
  smtpSecure        Boolean  @default(false)
  smtpUser          String
  // AES-256-GCM ciphertext, same scheme as EmailAccount (lib/credentialCrypto.js).
  smtpPassEncrypted String
  fromAddress       String
  fromName          String   @default("Global Capital BV")
  lastTestedAt      DateTime?
  updatedAt         DateTime @updatedAt
}

// Claude credentials for the AI Assistant and Market Intelligence, set
// from Admin Panel → AI Assistant. Stored here rather than relying on
// ANTHROPIC_API_KEY because env vars set in Coolify's UI don't reliably
// reach the container — see src/lib/aiSettings.js for the lookup order.
model AiSettings {
  id String @id @default(cuid())
  // AES-256-GCM ciphertext, same scheme as EmailAccount (lib/credentialCrypto.js).
  apiKeyEncrypted String
  model           String   @default("claude-sonnet-5")
  lastTestedAt    DateTime?
  updatedAt       DateTime @updatedAt

  // Which parts of the database the assistant may read (ids from
  // src/lib/aiDataSources.js). Empty means "everything" only on a fresh
  // install — the API writes the full default list on first save so an
  // admin unticking every box genuinely means none.
  dataSources String[] @default([])

  // Free-text company background pasted in by an admin. Always sent with
  // every question, unlike Data Room documents which are retrieved per
  // question — this is for the standing facts the assistant should never
  // have to look up.
  companyProfile String?
}

// Market Intelligence's data-source API keys (Exa, NewsAPI.ai, Firecrawl,
// Apollo), set from Admin Panel → Market Intelligence — same reasoning as
// AiSettings above: Coolify env vars don't reliably reach the container, so
// the DB is the path that actually works in production. Each key is
// optional (a source simply stays unconfigured/skipped until its key is
// set) and env vars remain a fallback for local dev — see
// src/lib/marketIntelligenceSettings.js for the lookup order.
model MarketIntelSettings {
  id                     String    @id @default(cuid())
  exaApiKeyEncrypted     String?
  newsApiKeyEncrypted    String?
  firecrawlApiKeyEncrypted String?
  apolloApiKeyEncrypted  String?
  updatedAt              DateTime  @updatedAt
}

// Company documents in the Data Room. The file itself lives on disk (a
// Docker volume — see docker-compose.coolify.yml), not in Postgres; only
// metadata and extracted text are stored here so the table stays small
// enough to query and to feed the AI assistant.
model Document {
  id           String   @id @default(cuid())
  originalName String
  // Random on-disk name. Never the uploaded filename — that would let a
  // crafted name escape the uploads directory or collide with another file.
  storedName String @unique
  mimeType   String
  sizeBytes  Int
  category   String  @default("General")
  description String?

  // Plain text pulled out at upload time (PDF/DOCX/plaintext). Null for
  // formats we can't read, e.g. images — those are still listed and
  // downloadable, they just can't be answered from.
  extractedText String?
  // Set when extraction was attempted but produced nothing usable, so the
  // UI can say why rather than silently showing an unsearchable file.
  extractionNote String?

  // Pinned documents are sent with every question rather than only when
  // keywords match — for the handful of files the assistant should always
  // know (company profile, product sheet, standard terms).
  pinnedToAi Boolean @default(false)

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  // Which deal this document belongs to. Null = the general company-wide
  // library (company profile, standard terms, etc. — not deal-specific,
  // used to ground the AI Assistant generally), same "null means legacy/
  // unscoped" convention as EmailCampaign.ownerChannelPartnerId. SetNull
  // rather than Cascade so deleting a Lead doesn't delete/orphan-on-disk a
  // real uploaded file — it just falls back into the unscoped library.
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId String?

  // Data Room KPI framework's status flow is Requested → Received →
  // Verified (see KPI Framework doc) — a document is "Received" the moment
  // it's uploaded, but only counts toward the completion % once someone
  // has actually reviewed and verified it. Separate from pinnedToAi: a
  // document can be AI-searchable and unverified at the same time.
  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedBy   User?     @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedById String?

  dealStages   DealStageRecord[]
  ndaDocuments NdaRecord[] @relation("NdaDocument")
  visitReports VisitPlan[] @relation("VisitReport")
  ioiDocuments IoiRecord[] @relation("IoiDocument")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
  @@index([leadId])
}

// The deal progression a lead moves through: NDA -> Zoom call -> Data Room
// -> IOI -> visit planning -> field visit -> term sheet.
//
// One table rather than seven, because the stages share a lifecycle
// (owner, status, planned/actual dates, notes, an optional document) and
// differ only in which of a handful of extra fields apply — amount and
// valuation for IOI/term sheet, location and attendees for the visits.
// Seven near-identical tables would mean seven of every query, route and
// screen; the per-stage differences are handled by field config in the UI
// (see src/components/dealStages/stageConfig.js).
enum DealStage {
  NDA
  ZOOM_CALL
  DATA_ROOM
  IOI
  VISIT_PLANNING
  FIELD_VISIT
  TERM_SHEET
}

enum DealStageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  ON_HOLD
}

model DealStageRecord {
  id     String @id @default(cuid())
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  stage  DealStage
  status DealStageStatus @default(NOT_STARTED)

  // Planned vs actual. scheduledAt is the intended date (NDA sent, visit
  // booked, term sheet issued); completedAt is when it actually happened
  // (signed, visited, accepted) — keeping both is what makes "overdue" and
  // "how long did this take" answerable later.
  scheduledAt DateTime?
  completedAt DateTime?

  // IOI / term sheet money. Free text rather than a numeric type: these
  // arrive as "EUR 2–4M" or "TBC" as often as a single figure, and forcing
  // a number would lose that.
  amount    String?
  valuation String?

  // Visit stages.
  location  String?
  attendees String?

  counterparty String?
  notes        String?
  owner        String?

  // Field Visit KPI framework's "Client Rating" target (4.5+) — out of 5,
  // decimals allowed (4.5). Only meaningful once a visit is actually
  // reported back, but stored generically since a future stage could
  // reasonably want it too.
  clientRating Float?

  // Optional supporting file, reusing the Data Room rather than a separate
  // upload path — a signed NDA or term sheet belongs in both places.
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One record per lead per stage; re-running a stage updates it rather
  // than silently creating a second row that queries would double-count.
  @@unique([leadId, stage])
  @@index([stage, status])
}

model PasswordResetToken {
  id String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  // Only the SHA-256 of the emailed token is stored, so a database leak
  // can't be replayed to take over accounts.
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Agent {
  id              String         @id @default(cuid())
  name            String
  role            String
  status          AgentStatus    @default(OFFLINE)
  assignedCount   Int            @default(0)
  resolvedCount   Int            @default(0)
  avgResponseMins Int            @default(0)
  csat            Float          @default(0)
  conversations   Conversation[]
  createdAt       DateTime       @default(now())
}

model Contact {
  id            String         @id @default(cuid())
  initials      String
  name          String
  company       String?
  phone         String         @unique
  stage         String?
  owner         String?
  tone          String         @default("blue")
  conversations Conversation[]
  createdAt     DateTime       @default(now())
}

model Lead {
  id               String     @id @default(cuid())
  initials         String
  name             String
  company          String
  email            String?
  mobile           String?
  capitalAsk       String
  status           LeadStatus @default(NEW)
  qualified        Boolean    @default(false)
  tone             String     @default("blue")
  owner            String?
  leadSource       String?
  territory        String?
  engagementStage  String?
  consentGdpr      String?
  notes            String?
  rawPayload       Json?

  // --- Universal Filters fields --------------------------------------
  // Everything below backs one of the 14 cross-report filter dimensions
  // (see lib/universalFilters.js). All nullable and manually set — none
  // of this arrives from the inbound webhook today, so a lead is filable
  // and searchable from day one without any of it being filled in yet.
  industry       String? // Industry filter
  channelPartner String? // Channel Partner filter
  temperature    LeadTemperature? // Hot/Warm/Cold filter — deliberately separate
  // from the decorative `tone` field above, which only ever picks an
  // avatar colour and has never meant anything about lead quality.
  teamLeader String? // Team Leader filter
  manager    String? // Manager filter
  // Deal Originator Executive — the rep who first engaged this prospect.
  // Free text, deliberately separate from `owner` (who currently holds the
  // account, which can change hands after the deal originates).
  doe String?

  // Free-text labels a rep applies from the lead panel's "Tags" button
  // (e.g. "Priority", "Referral") — unlike temperature/industry above,
  // these aren't a fixed vocabulary tied to a filter dimension.
  tags String[] @default([])

  // Raw company attributes from a ZoomInfo enrichment lookup (see
  // lib/zoominfoClient.js) — display-only, not queried on, so a single Json
  // blob is enough rather than a column per field (matches rawPayload's
  // precedent above for arbitrary upstream data). Set only when a match was
  // actually found; a lead a rep clicked "Enrich" on with no ZoomInfo match
  // stays null rather than storing an empty/fake result.
  zoomInfoData       Json?
  zoomInfoEnrichedAt DateTime?

  meetings   Meeting[]
  dealStages DealStageRecord[]
  ndaRecord  NdaRecord?
  visitPlans VisitPlan[]
  ioiRecord  IoiRecord?
  clientUser ClientUser?
  documents  Document[]
  activity   LeadActivityLog[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

enum LeadActivityKind {
  EMAIL_SENT
  STATUS_CHANGED
}

// A per-lead interaction/communication log for CRM Workspace -- direct
// communications with this lead (Send Mail sends, status changes), kept
// separate from the company-wide staff AuditLog (logins, permission
// changes -- a different concern entirely) and from ActivityLog (an
// unwired, unwritten dashboard decoration -- see its own schema comment).
// Mirrors EmailActivityLog's shape, scoped to Lead instead of EmailLead.
model LeadActivityLog {
  id        String           @id @default(cuid())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  kind      LeadActivityKind
  title     String
  detail    String
  createdAt DateTime         @default(now())

  @@index([leadId, createdAt])
}

// A login for the counterparty themselves — separate identity system from
// User (staff). One per lead: registering claims that specific deal's
// portal, so the dashboard has exactly one lead's progression to show,
// never a menu of deals to pick from.
model ClientUser {
  id           String           @id @default(cuid())
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId       String           @unique
  name         String
  email        String           @unique
  phone        String?
  passwordHash String
  status       ClientUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  passwordResets ClientPasswordResetToken[]
}

// Mirrors PasswordResetToken (staff) — kept as its own model rather than a
// shared/polymorphic table since ClientUser and User already have no other
// shared relations anywhere in this schema.
model ClientPasswordResetToken {
  id           String     @id @default(cuid())
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  clientUserId String
  tokenHash    String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([clientUserId])
}

enum ClientUserStatus {
  ACTIVE
  SUSPENDED
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

// A directory of referring/introducing partner organisations — distinct
// from Lead.channelPartner (a plain string filter tag on the lead itself).
// This is the partner as its own entity: who to contact there, what they're
// owed, whether the relationship is still active. Matched to leads by name
// rather than a foreign key, since Lead.channelPartner predates this model
// and stays free text everywhere else (Universal Filters, the CRM edit
// form) — adding a hard relation there would mean migrating every existing
// value and would block a lead from citing a partner not yet in this list.
model ChannelPartner {
  id            String               @id @default(cuid())
  name          String               @unique
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  region        String?
  commissionPct Float?
  status        ChannelPartnerStatus @default(ACTIVE)
  notes         String?

  // Same lightweight "clickwrap" e-signature as EmailLead's NDA flow (typed
  // name + IP + timestamp, see routes/channelPartnerAgreement.js) — not a
  // certified e-signature, but enough to record that whoever held the
  // signed link asserted agreement to the standard Channel Partner
  // Agreement.
  agreementSignedAt   DateTime?
  agreementSignedName String?
  agreementSignedIp   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portalUser     ChannelPartnerUser?
  ownedCampaigns EmailCampaign[]

  @@index([status])
}

// A Channel Partner's own login to their portal (see routes/
// channelPartnerAgreement.js and the frontend's separate portal SPA shell)
// — created in the same step as signing the agreement, never before.
// Mirrors ClientUser's shape (1:1 with its real-world record, email +
// passwordHash, no role/permissions system — a partner always gets the
// same fixed slice of the app, not a configurable one like staff).
model ChannelPartnerUser {
  id               String                   @id @default(cuid())
  channelPartner   ChannelPartner           @relation(fields: [channelPartnerId], references: [id], onDelete: Cascade)
  channelPartnerId String                   @unique
  name             String
  email            String                   @unique
  passwordHash     String
  status           ChannelPartnerUserStatus @default(ACTIVE)
  lastLoginAt      DateTime?

  // Optional extras beyond the always-included Dashboard/Campaigns/Leads/
  // Automation baseline (ids from lib/channelPartnerPermissions.js) --
  // those four are one shared API surface every portal account gets
  // unconditionally, not separately gatable, so they're never in this
  // array. Empty = exactly today's behavior.
  permissions String[] @default([])

  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

enum ChannelPartnerUserStatus {
  ACTIVE
  SUSPENDED
}

enum ChannelPartnerStatus {
  ACTIVE
  INACTIVE
  PROSPECTIVE
}

model ZoomSettings {
  id           String    @id @default(cuid())
  accountId    String?
  clientId     String?
  clientSecret String?
  hostEmail    String?
  connected    Boolean   @default(false)
  lastTestedAt DateTime?
}

// ZoomInfo's GTM API (OAuth2 client_credentials against api.zoominfo.com) —
// unrelated to Zoom video/meetings above despite the similar name. Used for
// CRM Workspace's "Enrich" action (lib/zoominfoClient.js), not the classic
// Zoom video-call product. clientSecret stored encrypted (see
// credentialCrypto.js), unlike ZoomSettings above which predates that
// convention — new credentials in this app follow the encrypted pattern.
model ZoomInfoSettings {
  id                    String    @id @default(cuid())
  clientId              String?
  clientSecretEncrypted String?
  connected             Boolean   @default(false)
  lastTestedAt          DateTime?
}

model Meeting {
  id              String    @id @default(cuid())
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id])
  topic           String
  startTime       DateTime
  durationMinutes Int       @default(30)
  zoomMeetingId   String?
  joinUrl         String?
  startUrl        String?
  status          String    @default("Scheduled")
  createdAt       DateTime  @default(now())

  // --- Qualitative capture (Zoom Call module) ---------------------------
  // Everything below is filled in after the call, so all of it is optional:
  // a meeting exists from the moment it's booked, long before there's
  // anything to record about it.

  // Who from the client side actually attended — often differs from who was
  // invited, and that difference is itself worth knowing.
  clientAttendees String?
  // Our own attendees (date-of-engagement contact / deal owner side).
  ourAttendees String?
  // Actual minutes, as opposed to durationMinutes which is what was booked.
  actualDurationMinutes Int?
  notes                 String?
  // Generated from notes by Claude on request (see POST /:id/summarise) —
  // stored so it isn't regenerated (and re-billed) on every page load.
  aiSummary          String?
  aiSummaryUpdatedAt DateTime?
  nextAction         String?
  nextActionDueAt    DateTime?
  // Whether a further meeting came out of this one — drives the
  // "next meeting scheduled %" KPI.
  nextMeetingScheduled Boolean @default(false)
  recordingLink        String?
  // 1-5, set by hand. Deliberately not inferred from the notes: a satisfaction
  // score a model guessed would look like data while being opinion.
  clientSatisfaction Int?

  // --- Zoom Cloud Recording transcript (separate from the above) --------
  // aiSummary above is generated from a rep's own typed notes; this is
  // generated from Zoom's own auto-transcript of what was actually said —
  // different provenance, kept as its own pair rather than overloading
  // aiSummary/aiSummaryUpdatedAt. Filled in either by the recording.completed
  // webhook (routes/zoomWebhook.js) once Zoom finishes processing, or by
  // manually clicking "Fetch Transcript" (POST /:id/fetch-transcript) for
  // whenever the webhook hasn't fired yet.
  zoomRecordingUuid          String?   @unique
  transcriptText             String?
  transcriptFetchedAt        DateTime?
  transcriptSummary          String?
  transcriptSummaryUpdatedAt DateTime?

  @@index([startTime])
}

// NDA tracking. Split out of DealStageRecord because chasing signatures has
// its own shape — two reminder timestamps, and the signing-time and
// reminder-effectiveness metrics that depend on them — which the shared
// stage table has no room for without becoming a wide grab-bag.
model NdaRecord {
  id     String @id @default(cuid())
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String @unique

  // SENT -> REMINDER_1 -> REMINDER_2 -> SIGNED, or DECLINED/EXPIRED.
  status NdaStatus @default(DRAFT)

  sentAt       DateTime?
  reminder1At  DateTime?
  reminder2At  DateTime?
  signedAt     DateTime?
  expiresAt    DateTime?

  signerName  String?
  signerEmail String?
  owner       String?
  notes       String?

  // Filled in by the client via the "fill in your details online" option
  // (server/src/routes/clientPortal.js's POST /nda/fill-details) — the
  // reciprocal NDA template's actual blanks (see assets/nda-template.pdf).
  // signerName/signerEmail above stay as the authenticated account that
  // took the action; these are the legal signatory named on the document,
  // which can be a different person. Null for the other two acceptance
  // paths (checkbox accept, upload a document) — there's nothing to fill.
  counterpartyLegalName String?
  counterpartyCountry   String?
  counterpartyAddress   String?
  agreementDate         DateTime?
  signatoryName         String?
  signatoryTitle        String?

  // The signed copy, kept in the Data Room rather than a second upload path.
  document   Document? @relation("NdaDocument", fields: [documentId], references: [id], onDelete: SetNull)
  documentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum NdaStatus {
  DRAFT
  SENT
  REMINDER_1
  REMINDER_2
  SIGNED
  DECLINED
  EXPIRED
}

// Site-visit planning. Separate from FIELD_VISIT (the visit itself) because
// planning is about travel efficiency — cost, geography, clustering — and
// several planned visits can share one trip.
model VisitPlan {
  id     String @id @default(cuid())
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  status VisitPlanStatus @default(PLANNED)

  plannedFor  DateTime?
  completedAt DateTime?

  // Free text, plus a coarse region used to cluster visits. Region is what
  // makes "how many trips could be combined" answerable without geocoding
  // every address — see lib/visitMetrics.js.
  location String?
  region   String?
  country  String?

  attendees String?
  purpose   String?
  notes     String?
  owner     String?

  // Actual spend, in whole currency units. Numeric here (unlike IOI/term
  // sheet amounts) because cost-per-visit has to be averaged.
  costAmount   Float?
  costCurrency String  @default("EUR")

  travelMode String?

  reportSubmitted Boolean   @default(false)
  reportAt        DateTime?
  report          Document? @relation("VisitReport", fields: [reportId], references: [id], onDelete: SetNull)
  reportId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plannedFor])
  @@index([region])
}

enum VisitPlanStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Conversation {
  id            String             @id @default(cuid())
  contactId     String
  contact       Contact            @relation(fields: [contactId], references: [id])
  agentId       String?
