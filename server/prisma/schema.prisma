generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationStatus {
  NEW
  ASSIGNED
  REPLIED
  RESOLVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  IN_REVIEW
  REJECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
}

enum SequenceStatus {
  ACTIVE
  PAUSED
}

enum MatchType {
  CONTAINS
  EXACT
}

enum RuleStatus {
  ACTIVE
  PAUSED
}

enum FlowStepType {
  TRIGGER
  MESSAGE
  QUESTION
  CONDITION
  ACTION
}

enum TriggerStatus {
  ACTIVE
  DRAFT
}

enum AgentStatus {
  ONLINE
  AWAY
  OFFLINE
}

model Agent {
  id              String         @id @default(cuid())
  name            String
  role            String
  status          AgentStatus    @default(OFFLINE)
  assignedCount   Int            @default(0)
  resolvedCount   Int            @default(0)
  avgResponseMins Int            @default(0)
  csat            Float          @default(0)
  conversations   Conversation[]
  createdAt       DateTime       @default(now())
}

model Contact {
  id            String         @id @default(cuid())
  initials      String
  name          String
  company       String?
  phone         String         @unique
  stage         String?
  owner         String?
  tone          String         @default("blue")
  conversations Conversation[]
  createdAt     DateTime       @default(now())
}

model Lead {
  id               String     @id @default(cuid())
  initials         String
  name             String
  company          String
  email            String?
  mobile           String?
  capitalAsk       String
  status           LeadStatus @default(NEW)
  qualified        Boolean    @default(false)
  tone             String     @default("blue")
  owner            String?
  leadSource       String?
  territory        String?
  engagementStage  String?
  consentGdpr      String?
  notes            String?
  rawPayload       Json?
  meetings         Meeting[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
}

model ZoomSettings {
  id           String    @id @default(cuid())
  accountId    String?
  clientId     String?
  clientSecret String?
  hostEmail    String?
  connected    Boolean   @default(false)
  lastTestedAt DateTime?
}

model Meeting {
  id              String    @id @default(cuid())
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id])
  topic           String
  startTime       DateTime
  durationMinutes Int       @default(30)
  zoomMeetingId   String?
  joinUrl         String?
  startUrl        String?
  status          String    @default("Scheduled")
  createdAt       DateTime  @default(now())

  @@index([startTime])
}

model Conversation {
  id            String             @id @default(cuid())
  contactId     String
  contact       Contact            @relation(fields: [contactId], references: [id])
  agentId       String?
  agent         Agent?             @relation(fields: [agentId], references: [id])
  status        ConversationStatus @default(NEW)
  lastPreview   String?
  lastMessageAt DateTime           @default(now())
  unreadCount   Int                @default(0)
  messages      Message[]
  createdAt     DateTime           @default(now())
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  direction      MessageDirection
  body           String
  templateName   String?
  status         MessageStatus    @default(SENT)
  sentAt         DateTime         @default(now())

  @@index([sentAt])
  @@index([conversationId])
}

model Template {
  id         String           @id @default(cuid())
  name       String           @unique
  category   TemplateCategory
  language   String           @default("English")
  status     TemplateStatus   @default(IN_REVIEW)
  bodyText   String
  footerText String?
  uses       Int              @default(0)
  readRate   Float            @default(0)
  replyRate  Float            @default(0)
  lastSentAt DateTime?
  campaigns  Campaign[]
  createdAt  DateTime         @default(now())
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  templateId     String
  template       Template       @relation(fields: [templateId], references: [id])
  audienceLabel  String
  status         CampaignStatus @default(DRAFT)
  sentCount      Int            @default(0)
  deliveredCount Int            @default(0)
  readCount      Int            @default(0)
  repliedCount   Int            @default(0)
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
}

model DripSequence {
  id             String         @id @default(cuid())
  name           String
  trigger        String
  enrolledCount  Int            @default(0)
  completionRate Float          @default(0)
  status         SequenceStatus @default(ACTIVE)
  steps          DripStep[]
  createdAt      DateTime       @default(now())
}

model DripStep {
  id             String       @id @default(cuid())
  sequenceId     String
  sequence       DripSequence @relation(fields: [sequenceId], references: [id])
  stepOrder      Int
  title          String
  delayLabel     String
  message        String
  engagementRate Float        @default(0)
}

model AutoReplySettings {
  id              String  @id @default(cuid())
  greetingEnabled Boolean @default(true)
  greetingMessage String
  awayEnabled     Boolean @default(true)
  awayMessage     String
  awayHours       String
}

model AutoReplyRule {
  id        String     @id @default(cuid())
  keyword   String
  matchType MatchType  @default(CONTAINS)
  reply     String
  status    RuleStatus @default(ACTIVE)
  triggered Int        @default(0)
  createdAt DateTime   @default(now())
}

model BotFlow {
  id             String        @id @default(cuid())
  name           String
  trigger        String
  completionRate Float?
  active         Boolean       @default(true)
  usersCount     Int           @default(0)
  steps          BotFlowStep[]
  createdAt      DateTime      @default(now())
}

model BotFlowStep {
  id        String       @id @default(cuid())
  flowId    String
  flow      BotFlow      @relation(fields: [flowId], references: [id])
  stepOrder Int
  type      FlowStepType
  label     String
  detail    String
}

model CrmTrigger {
  id              String        @id @default(cuid())
  event           String
  action          String
  status          TriggerStatus @default(ACTIVE)
  lastTriggeredAt DateTime?
  createdAt       DateTime      @default(now())
}

model AutomationRule {
  id         String  @id @default(cuid())
  name       String
  condition  String
  action     String
  enabled    Boolean @default(true)
  executions Int     @default(0)
  createdAt  DateTime @default(now())
}

model BusinessSettings {
  id          String   @id @default(cuid())
  phone       String
  displayName String
  category    String
  wabaId      String
  tier        String
  quality     String
  status      String   @default("Connected")
  webhookUrl  String
  webhookVerifyToken String
  appIdMasked String
  tokenStatus String
  lastPingAt  DateTime @default(now())

  // WhatsApp Cloud API connection (Embedded Signup / manual credentials)
  embeddedSignupConfigId String?
  phoneNumberId          String?
  accessToken            String?
  appId                  String?
  appSecret              String?
  campaignBatchSize      Int     @default(50)

  // Defaults applied when auto-creating a CRM lead from an unknown inbound number
  autoCreateLead        Boolean @default(false)
  leadDefaultStatus      String  @default("Default")
  leadDefaultSource      String  @default("Default")
  leadDefaultAssignedTo  String  @default("Default")

  // API key external platforms use to POST leads into /api/leads/inbound
  leadWebhookApiKey String?
}

model WhatsappPhoneNumber {
  id            String   @id @default(cuid())
  phoneNumber   String
  displayName   String
  qualityRating String   @default("Unknown")
  status        String   @default("Connected")
  isSending     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model BusinessHour {
  id         String @id @default(cuid())
  dayLabel   String
  hoursLabel String
  sortOrder  Int    @default(0)
}

model NotificationPreference {
  id      String  @id @default(cuid())
  label   String
  enabled Boolean @default(true)
}

model ActivityLog {
  id        String   @id @default(cuid())
  who       String
  what      String
  tone      String   @default("blue")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
