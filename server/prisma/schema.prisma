// ============================================================================
// Email cold-outreach domain (campaigns/leads/cadence/templates/market
// intelligence) — merged in from the `crm` branch. Named distinctly from the
// WhatsApp-domain models above (EmailCampaign vs. Campaign, EmailLead vs.
// Lead, EmailTemplate vs. Template, EmailActivityLog vs. ActivityLog) even
// though the concepts rhyme, because the two are genuinely different data
// shapes for different channels — collapsing them into one model would lose
// real fields on both sides. EmailAccount/CadenceStep/ReplyEvent/MarketSignal
// had no name collision and keep their original names.
// ============================================================================

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
}

enum ReplyType {
  INTERESTED
  ZOOM_REQUEST
  INFO_REQUEST
  // A genuine reply that classifyReply.js's keyword rules don't recognize
  // (e.g. a plain "Ok") -- distinct from NO_REPLY, which means no reply has
  // arrived at all. Conflating the two meant a lead who *did* reply, just
  // not with a recognized keyword, still showed up everywhere ("no reply
  // yet") as if they'd never responded.
  OTHER
  NO_REPLY
}

enum EmailActivityKind {
  BULK_INTRO_SENT
  REPLY_RECEIVED
  BRANCH_EMAIL_QUEUED
  BRANCH_EMAIL_SENT
  STAGE_CHANGED
  MANUAL_NOTE
  BOUNCED
  SEND_BLOCKED
  NDA_SIGNED
  CALL_BOOKED
  CALL_CANCELED
  CALL_COMPLETED
  EMAIL_OPENED
  LINK_CLICKED
}

enum BounceKind {
  HARD
  SOFT
  COMPLAINT
}

model EmailCampaign {
  id            String              @id @default(cuid())
  name          String
  status        EmailCampaignStatus @default(DRAFT)
  audience      String
  template      String
  dailyLimit    Int                 @default(2000)
  delayDays     Int                 @default(3)
  followUpCount Int                 @default(3)
  abTest        Boolean             @default(true)
  autoPause     Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Where a lead's reply should land — set this when it needs to differ
  // from the sending mailbox itself (e.g. routing replies to a shared
  // team inbox instead of the individual account a campaign sends
  // through). Null = replies just go to whichever mailbox actually sent
  // the email, the normal email behavior with no header override.
  replyTo String?

  // Which mailbox this campaign sends through. Null = fall back to the
  // single global EMAIL_PROVIDER/.env-configured provider.
  emailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id])
  emailAccountId String?

  // Null = an admin-owned campaign (all existing data, unchanged
  // behavior). Set = created by a Channel Partner through their own
  // portal (see lib/channelPartnerScope.js) — every list/create/dashboard
  // query for that portal is scoped to this field, so a partner only ever
  // sees their own campaigns (and, transitively, their own leads).
  ownerChannelPartner   ChannelPartner? @relation(fields: [ownerChannelPartnerId], references: [id], onDelete: Cascade)
  ownerChannelPartnerId String?

  leads        EmailLead[]
  cadenceSteps CadenceStep[]
  segments     EmailSegment[]

  @@index([status])
  @@index([ownerChannelPartnerId])
}

model EmailAccount {
  id         String  @id @default(cuid())
  label      String
  smtpHost   String
  smtpPort   Int
  smtpSecure Boolean @default(true)
  smtpUser   String
  // AES-256-GCM ciphertext (see src/lib/credentialCrypto.js), never the
  // plaintext password — decrypted in memory only at the moment of
  // building an SMTP transporter.
  smtpPassEncrypted String
  fromAddress       String
  dailyLimit        Int      @default(500)
  isActive          Boolean  @default(true)
  // Which country/region this mailbox represents (e.g. "IN", "AE", "NL") —
  // matched case-insensitively against EmailLead.country at send time (see
  // src/lib/accountRouting.js) so a lead automatically sends through the
  // mailbox for their own country instead of always using whatever single
  // mailbox is assigned to the whole campaign. Null = no country match,
  // this account is only used when directly assigned to a campaign (or as
  // the global fallback).
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // null = a shared/company mailbox (managed by an Admin, usable in any
  // campaign). Set = a personal mailbox owned by that employee — only they
  // (or an Admin) can see or edit it.
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String?

  campaigns EmailCampaign[]
  sentActivity EmailActivityLog[]

  @@index([ownerId])
  @@index([country])
}

model CadenceStep {
  id           String        @id @default(cuid())
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  stepIndex    Int
  title        String
  bodyTemplate String
  delayDays    Int

  @@unique([campaignId, stepIndex])
}

model EmailLead {
  id           String    @id @default(cuid())
  name         String
  company      String
  email        String
  owner        String
  // Which country this lead is in — drives automatic sending-mailbox
  // routing (see src/lib/accountRouting.js): matched case-insensitively
  // against EmailAccount.country. Null = no country-based routing, this
  // lead just uses whatever mailbox the campaign is assigned to.
  country      String?
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id])
  campaignId   String
  replyType    ReplyType @default(NO_REPLY)
  stage        String    @default("Reminder Pending")
  unsubscribed Boolean   @default(false)
  // A hard bounce or spam complaint suppresses this lead permanently; a
  // soft bounce (mailbox full, temp DNS failure) does not — see
  // src/routes/bounces.js.
  bounced    Boolean     @default(false)
  bounceKind BounceKind?
  // A lightweight "clickwrap" e-signature (typed name + IP + timestamp),
  // not a certified signature the way DocuSign/HelloSign produce one — see
  // routes/nda.js for what this actually captures and its limits.
  ndaSignedAt   DateTime?
  ndaSignedName String?
  ndaSignedIp   String?
  // Calendly tells you a meeting was booked (invitee.created) or canceled
  // (invitee.canceled) via webhook — it does NOT tell you whether anyone
  // actually showed up. callCompletedAt is a manual confirmation
  // (POST /email/leads/:id/mark-call-completed), not something Calendly reports.
  callBookedAt     DateTime?
  callScheduledFor DateTime?
  callCanceledAt   DateTime?
  callCompletedAt  DateTime?
  // Set once a rep converts this cold-outreach contact into a real CRM Lead
  // (POST /api/leads/from-email-lead/:emailLeadId) — a plain id, not a
  // formal relation, so the "already converted" guard still holds even if
  // that Lead is later deleted. The portal invite only fires at this point,
  // not on the original cold email: there's no deal to show progress on
  // until a Lead exists (see the onDelete/relation note on ClientUser).
  convertedToLeadId String?
  convertedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  replyEvents      ReplyEvent[]
  activityLog      EmailActivityLog[]
  matchedBySignals MarketSignal[]     @relation("MarketSignalMatchedLead")
  createdBySignals MarketSignal[]     @relation("MarketSignalCreatedLead")
  aiReplyDrafts    AiReplyDraft[]

  @@index([campaignId])
  @@index([email])
}

model ReplyEvent {
  id          String    @id @default(cuid())
  lead        EmailLead @relation(fields: [leadId], references: [id])
  leadId      String
  rawBody     String
  matchedRule String?
  replyType   ReplyType
  receivedAt  DateTime  @default(now())
}

model EmailActivityLog {
  id        String            @id @default(cuid())
  lead      EmailLead         @relation(fields: [leadId], references: [id])
  leadId    String
  kind      EmailActivityKind
  title     String
  detail    String
  createdAt DateTime          @default(now())

  // Which mailbox a real send actually went out through — set only on
  // BRANCH_EMAIL_SENT rows (see src/lib/leadSender.js and
  // src/queue/cadenceQueue.js). This is what the per-mailbox daily cap
  // (src/lib/accountSendCap.js) counts against; it deliberately doesn't
  // infer the account from the campaign's assignment, since country-based
  // routing (src/lib/accountRouting.js) can resolve a different account
  // per lead than whatever the campaign itself is assigned to.
  emailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)
  emailAccountId String?

  @@index([leadId, createdAt])
  @@index([emailAccountId, kind, createdAt])
}

model EmailTemplate {
  id      String  @id @default(cuid())
  key     String  @unique
  subject String
  body    String
  // Optional branded HTML version. When null, the send path wraps `body`
  // in a default branded shell (see src/lib/renderTemplate.js) rather than
  // sending plain text with no company identity/unsubscribe link.
  html      String?
  updatedAt DateTime @updatedAt
}

enum SignalSource {
  NEWSAPI
  EXA
  FIRECRAWL
  // Google News RSS search feed — unlike the other three, needs no API key
  // or account, so it's the one source here that can produce real signals
  // without waiting on a credential. See sources/googleNewsRssSource.js.
  GOOGLE_NEWS
}

enum SignalType {
  FUNDING
  ACQUISITION
  EXPANSION
  LEADERSHIP_CHANGE
  DISTRESS
  OTHER
}

// Admin-editable point values behind Market Signal's relevanceScore (see
// lib/scoringCriteria.js) — "how many points for X" made literal rather
// than buried in a prompt string. The AI only ever extracts facts (which
// signal type, whether concrete detail/a named entity is present); this
// table is what turns those facts into the actual 0-100 number, so an
// admin can retune scoring without a code change or redeploy.
model ScoringCriterion {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  points    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SignalStatus {
  PENDING // fetched, not yet AI-processed
  PROCESSED // AI-processed, routed (matched existing lead or created new one)
  DUPLICATE // matched contentHash of an already-seen signal, discarded
  IGNORED // processed but below relevance threshold / no entity match, no action taken
  FAILED // a source or AI-processing error stopped this signal short — see failureReason
}

// One row per raw item pulled from a source, carrying it through AI
// processing and routing. Matches against EmailLead.company free-text.
model MarketSignal {
  id             String       @id @default(cuid())
  source         SignalSource
  sourceUrl      String
  rawTitle       String
  rawContent     String
  rawPublishedAt DateTime?
  fetchedAt      DateTime     @default(now())

  // SHA-256 of source + normalized rawTitle, used for dedup (see
  // lib/marketIntelligence/dedup.js).
  contentHash String @unique

  status        SignalStatus @default(PENDING)
  failureReason String?

  // Filled in by AI processing (lib/marketIntelligence/aiProcessor.js) —
  // null until status moves past PENDING.
  entityName     String?
  signalType     SignalType?
  relevanceScore Int? // 0-100
  aiSummary      String?
  // True when the article says the company is currently looking to raise
  // (in talks, exploring options, engaged advisors) as opposed to reporting
  // a round that already closed — the single highest-value distinction for
  // deal sourcing, since a company mid-raise is an active, reachable
  // opportunity today. See lib/marketIntelligence/aiProcessor.js.
  isSeekingFunding Boolean?

  // Routing outcome: either an existing lead this signal updated, or a
  // newly-created one from an Apollo lookup — never both.
  matchedLeadId String?
  matchedLead   EmailLead? @relation("MarketSignalMatchedLead", fields: [matchedLeadId], references: [id])
  createdLeadId String?
  createdLead   EmailLead? @relation("MarketSignalCreatedLead", fields: [createdLeadId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
  @@index([entityName])
}

// Indications of interest. Like the NDA, this outgrew DealStageRecord: the
// spec wants an average IOI value in euros and distributions by industry
// and geography, none of which the shared table can express (its `amount`
// is free text, and it carries no industry or geography at all).
model IoiRecord {
  id     String @id @default(cuid())
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String @unique

  status IoiStatus @default(DRAFT)

  generatedAt DateTime?
  sentAt      DateTime?
  signedAt    DateTime?
  expiresAt   DateTime?

  // Numeric, deliberately unlike DealStageRecord.amount which is free text.
  // "EUR 2-4M" cannot be averaged, and the spec asks for an average value.
  // Where a range is genuinely all that is known, record the midpoint here
  // and put the range itself in notes.
  value         Float?
  valueCurrency String @default("EUR")

  // The spec asks for IOI-by-industry and IOI-by-geography distributions.
  // Lead carries neither (it has `territory`, which is a sales region, not
  // the counterparty's geography), so both live here.
  industry  String?
  geography String?

  counterparty String?
  owner        String?
  notes        String?

  // Filled in by the client via the "fill in your details online" option —
  // the LOI template's actual blanks (see assets/ioi-template.docx): the
  // borrower's jurisdiction, project cost and equity contribution, plus
  // the signature block. `counterparty` above stays the company name;
  // these are the individual signatory's own details, which can differ.
  counterpartyJurisdiction String?
  totalProjectCost         String?
  borrowerEquity           String?
  signatoryName            String?
  signatoryAddress         String?
  signatoryPhone           String?
  signatoryEmail           String?
  agreementDate            DateTime?

  document   Document? @relation("IoiDocument", fields: [documentId], references: [id], onDelete: SetNull)
  documentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([industry])
  @@index([geography])
}

enum IoiStatus {
  DRAFT
  GENERATED
  SENT
  SIGNED
  DECLINED
  EXPIRED
}

// ============================================================================
// Segments (Email Automation → Segments tab) — a saved filter over EmailLead
// rows within a list (campaign), evaluated live rather than snapshotted, so
// matchingCount always reflects the current lead data instead of drifting
// stale the moment a lead's stage/reply changes. `conditions` is a small JSON
// array ({ field, operator, value }[]) rather than one row per condition —
// there's no need to query/join on a single condition independently, and the
// UI always reads/writes the whole list as one unit (see
// lib/segmentMatching.js for the matching logic and the fixed field/operator
// vocabulary it accepts).
// ============================================================================

enum SegmentMatchType {
  ALL
  ANY
}

model EmailSegment {
  id         String           @id @default(cuid())
  name       String
  // Null = spans every list, not just one campaign's leads.
  campaign   EmailCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?
  matchType  SegmentMatchType @default(ALL)
  conditions Json
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([campaignId])
}

// ============================================================================
// AI Agent (Email Automation → AI Agent tab) — drafts a reply for a lead who
// has actually replied (using the real inbound text off their most recent
// ReplyEvent, see lib/aiReplyAgent.js), holds it for human review, and only
// sends it through the existing leadSender.js pipeline once a person clicks
// Send — never automatically. Regenerating while still DRAFT overwrites the
// same row (see routes/emailAiAgent.js); once QUEUED/SENT/SKIPPED/FAILED the
// row is a historical record and a fresh generate creates a new one instead.
// ============================================================================

enum AiReplyDraftStatus {
  DRAFT
  SENT
  SKIPPED
  FAILED
}

model AiReplyDraft {
  id       String @id @default(cuid())
  lead     EmailLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId   String
  subject  String
  body     String
  status   AiReplyDraftStatus @default(DRAFT)
  // Which model actually produced this draft — admin-configurable (Admin
  // Panel → AI Assistant), so this can differ per draft over time.
  model    String?
  // Set only on a FAILED send attempt (leadSender.js threw) — kept instead
  // of silently reverting to DRAFT, so a suppressed/capped-out send is
  // visible rather than looking like it's still just waiting for review.
  error    String?
  // The EmailActivityLog row leadSender.js created for the real send —
  // lets the UI link straight from a SENT draft to its actual send record.
  sentActivityId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([status])
}
