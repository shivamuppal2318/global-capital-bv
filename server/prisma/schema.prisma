generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationStatus {
  NEW
  ASSIGNED
  REPLIED
  RESOLVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  IN_REVIEW
  REJECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
}

enum SequenceStatus {
  ACTIVE
  PAUSED
}

enum MatchType {
  CONTAINS
  EXACT
}

enum RuleStatus {
  ACTIVE
  PAUSED
}

enum FlowStepType {
  TRIGGER
  MESSAGE
  QUESTION
  CONDITION
  ACTION
}

enum TriggerStatus {
  ACTIVE
  DRAFT
}

enum AgentStatus {
  ONLINE
  AWAY
  OFFLINE
}

// Server-managed secrets that must survive restarts but should never live in
// the repo or a compose file — currently just the JWT signing key, which is
// generated on first boot when JWT_SECRET isn't supplied via the environment.
model AppSecret {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// A real login account (bcrypt-hashed password, JWT auth) — distinct from
// Agent above, which is just a display/assignment label for WhatsApp
// conversations and predates this model having no credentials of its own.
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Module ids (see src/lib/permissions.js) this employee may open. Only
  // consulted for EMPLOYEE — an ADMIN always has every module, so revoking
  // an admin's access means demoting them first.
  permissions String[] @default([])

  // Personal SMTP mailboxes this employee owns (see EmailAccount.ownerId).
  emailAccounts EmailAccount[]
  passwordResets PasswordResetToken[]
  documents      Document[]
}

// Single row holding the company-wide "system" mailbox used for
// transactional mail the app sends about itself — password resets and new
// account handoffs. Deliberately separate from EmailAccount, which is for
// outbound sales campaigns: those are per-user and get rotated/paused, and
// password reset delivery must not depend on a salesperson's mailbox.
model SystemEmailSettings {
  id                String   @id @default(cuid())
  smtpHost          String
  smtpPort          Int      @default(587)
  smtpSecure        Boolean  @default(false)
  smtpUser          String
  // AES-256-GCM ciphertext, same scheme as EmailAccount (lib/credentialCrypto.js).
  smtpPassEncrypted String
  fromAddress       String
  fromName          String   @default("Global Capital BV")
  lastTestedAt      DateTime?
  updatedAt         DateTime @updatedAt
}

// Claude credentials for the AI Assistant and Market Intelligence, set
// from Admin Panel → AI Assistant. Stored here rather than relying on
// ANTHROPIC_API_KEY because env vars set in Coolify's UI don't reliably
// reach the container — see src/lib/aiSettings.js for the lookup order.
model AiSettings {
  id String @id @default(cuid())
  // AES-256-GCM ciphertext, same scheme as EmailAccount (lib/credentialCrypto.js).
  apiKeyEncrypted String
  model           String   @default("claude-sonnet-5")
  lastTestedAt    DateTime?
  updatedAt       DateTime @updatedAt
}

// Market Intelligence's data-source API keys (Exa, NewsAPI.ai, Firecrawl,
// Apollo), set from Admin Panel → Market Intelligence — same reasoning as
// AiSettings above: Coolify env vars don't reliably reach the container, so
// the DB is the path that actually works in production. Each key is
// optional (a source simply stays unconfigured/skipped until its key is
// set) and env vars remain a fallback for local dev — see
// src/lib/marketIntelligenceSettings.js for the lookup order.
model MarketIntelSettings {
  id                     String    @id @default(cuid())
  exaApiKeyEncrypted     String?
  newsApiKeyEncrypted    String?
  firecrawlApiKeyEncrypted String?
  apolloApiKeyEncrypted  String?
  updatedAt              DateTime  @updatedAt
}

// Company documents in the Data Room. The file itself lives on disk (a
// Docker volume — see docker-compose.coolify.yml), not in Postgres; only
// metadata and extracted text are stored here so the table stays small
// enough to query and to feed the AI assistant.
model Document {
  id           String   @id @default(cuid())
  originalName String
  // Random on-disk name. Never the uploaded filename — that would let a
  // crafted name escape the uploads directory or collide with another file.
  storedName String @unique
  mimeType   String
  sizeBytes  Int
  category   String  @default("General")
  description String?

  // Plain text pulled out at upload time (PDF/DOCX/plaintext). Null for
  // formats we can't read, e.g. images — those are still listed and
  // downloadable, they just can't be answered from.
  extractedText String?
  // Set when extraction was attempted but produced nothing usable, so the
  // UI can say why rather than silently showing an unsearchable file.
  extractionNote String?

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  // Only the SHA-256 of the emailed token is stored, so a database leak
  // can't be replayed to take over accounts.
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Agent {
  id              String         @id @default(cuid())
  name            String
  role            String
  status          AgentStatus    @default(OFFLINE)
  assignedCount   Int            @default(0)
  resolvedCount   Int            @default(0)
  avgResponseMins Int            @default(0)
  csat            Float          @default(0)
  conversations   Conversation[]
  createdAt       DateTime       @default(now())
}

model Contact {
  id            String         @id @default(cuid())
  initials      String
  name          String
  company       String?
  phone         String         @unique
  stage         String?
  owner         String?
  tone          String         @default("blue")
  conversations Conversation[]
  createdAt     DateTime       @default(now())
}

model Lead {
  id               String     @id @default(cuid())
  initials         String
  name             String
  company          String
  email            String?
  mobile           String?
  capitalAsk       String
  status           LeadStatus @default(NEW)
  qualified        Boolean    @default(false)
  tone             String     @default("blue")
  owner            String?
  leadSource       String?
  territory        String?
  engagementStage  String?
  consentGdpr      String?
  notes            String?
  rawPayload       Json?
  meetings         Meeting[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([status])
}

model ZoomSettings {
  id           String    @id @default(cuid())
  accountId    String?
  clientId     String?
  clientSecret String?
  hostEmail    String?
  connected    Boolean   @default(false)
  lastTestedAt DateTime?
}

model Meeting {
  id              String    @id @default(cuid())
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id])
  topic           String
  startTime       DateTime
  durationMinutes Int       @default(30)
  zoomMeetingId   String?
  joinUrl         String?
  startUrl        String?
  status          String    @default("Scheduled")
  createdAt       DateTime  @default(now())

  @@index([startTime])
}

model Conversation {
  id            String             @id @default(cuid())
  contactId     String
  contact       Contact            @relation(fields: [contactId], references: [id])
  agentId       String?
  agent         Agent?             @relation(fields: [agentId], references: [id])
  status        ConversationStatus @default(NEW)
  lastPreview   String?
  lastMessageAt DateTime           @default(now())
  unreadCount   Int                @default(0)
  messages      Message[]
  createdAt     DateTime           @default(now())
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  direction      MessageDirection
  body           String
  templateName   String?
  status         MessageStatus    @default(SENT)
  sentAt         DateTime         @default(now())

  @@index([sentAt])
  @@index([conversationId])
}

model Template {
  id         String           @id @default(cuid())
  name       String           @unique
  category   TemplateCategory
  language   String           @default("English")
  status     TemplateStatus   @default(IN_REVIEW)
  bodyText   String
  footerText String?
  uses       Int              @default(0)
  readRate   Float            @default(0)
  replyRate  Float            @default(0)
  lastSentAt DateTime?
  campaigns  Campaign[]
  createdAt  DateTime         @default(now())
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  templateId     String
  template       Template       @relation(fields: [templateId], references: [id])
  audienceLabel  String
  status         CampaignStatus @default(DRAFT)
  sentCount      Int            @default(0)
  deliveredCount Int            @default(0)
  readCount      Int            @default(0)
  repliedCount   Int            @default(0)
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
}

model DripSequence {
  id             String         @id @default(cuid())
  name           String
  trigger        String
  enrolledCount  Int            @default(0)
  completionRate Float          @default(0)
  status         SequenceStatus @default(ACTIVE)
  steps          DripStep[]
  createdAt      DateTime       @default(now())
}

model DripStep {
  id             String       @id @default(cuid())
  sequenceId     String
  sequence       DripSequence @relation(fields: [sequenceId], references: [id])
  stepOrder      Int
  title          String
  delayLabel     String
  message        String
  engagementRate Float        @default(0)
}

model AutoReplySettings {
  id              String  @id @default(cuid())
  greetingEnabled Boolean @default(true)
  greetingMessage String
  awayEnabled     Boolean @default(true)
  awayMessage     String
  awayHours       String
}

model AutoReplyRule {
  id        String     @id @default(cuid())
  keyword   String
  matchType MatchType  @default(CONTAINS)
  reply     String
  status    RuleStatus @default(ACTIVE)
  triggered Int        @default(0)
  createdAt DateTime   @default(now())
}

model BotFlow {
  id             String        @id @default(cuid())
  name           String
  trigger        String
  completionRate Float?
  active         Boolean       @default(true)
  usersCount     Int           @default(0)
  steps          BotFlowStep[]
  createdAt      DateTime      @default(now())
}

model BotFlowStep {
  id        String       @id @default(cuid())
  flowId    String
  flow      BotFlow      @relation(fields: [flowId], references: [id])
  stepOrder Int
  type      FlowStepType
  label     String
  detail    String
}

model CrmTrigger {
  id              String        @id @default(cuid())
  event           String
  action          String
  status          TriggerStatus @default(ACTIVE)
  lastTriggeredAt DateTime?
  createdAt       DateTime      @default(now())
}

model AutomationRule {
  id         String  @id @default(cuid())
  name       String
  condition  String
  action     String
  enabled    Boolean @default(true)
  executions Int     @default(0)
  createdAt  DateTime @default(now())
}

model BusinessSettings {
  id          String   @id @default(cuid())
  phone       String
  displayName String
  category    String
  wabaId      String
  tier        String
  quality     String
  status      String   @default("Connected")
  webhookUrl  String
  webhookVerifyToken String
  appIdMasked String
  tokenStatus String
  lastPingAt  DateTime @default(now())

  // WhatsApp Cloud API connection (Embedded Signup / manual credentials)
  embeddedSignupConfigId String?
  phoneNumberId          String?
  accessToken            String?
  appId                  String?
  appSecret              String?
  campaignBatchSize      Int     @default(50)

  // Defaults applied when auto-creating a CRM lead from an unknown inbound number
  autoCreateLead        Boolean @default(false)
  leadDefaultStatus      String  @default("Default")
  leadDefaultSource      String  @default("Default")
  leadDefaultAssignedTo  String  @default("Default")

  // API key external platforms use to POST leads into /api/leads/inbound
  leadWebhookApiKey String?
}

model WhatsappPhoneNumber {
  id            String   @id @default(cuid())
  phoneNumber   String
  displayName   String
  qualityRating String   @default("Unknown")
  status        String   @default("Connected")
  isSending     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model BusinessHour {
  id         String @id @default(cuid())
  dayLabel   String
  hoursLabel String
  sortOrder  Int    @default(0)
}

model NotificationPreference {
  id      String  @id @default(cuid())
  label   String
  enabled Boolean @default(true)
}

model ActivityLog {
  id        String   @id @default(cuid())
  who       String
  what      String
  tone      String   @default("blue")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================================
// Email cold-outreach domain (campaigns/leads/cadence/templates/market
// intelligence) — merged in from the `crm` branch. Named distinctly from the
// WhatsApp-domain models above (EmailCampaign vs. Campaign, EmailLead vs.
// Lead, EmailTemplate vs. Template, EmailActivityLog vs. ActivityLog) even
// though the concepts rhyme, because the two are genuinely different data
// shapes for different channels — collapsing them into one model would lose
// real fields on both sides. EmailAccount/CadenceStep/ReplyEvent/MarketSignal
// had no name collision and keep their original names.
// ============================================================================

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
}

enum ReplyType {
  INTERESTED
  ZOOM_REQUEST
  INFO_REQUEST
  NO_REPLY
}

enum EmailActivityKind {
  BULK_INTRO_SENT
  REPLY_RECEIVED
  BRANCH_EMAIL_QUEUED
  BRANCH_EMAIL_SENT
  STAGE_CHANGED
  MANUAL_NOTE
  BOUNCED
  SEND_BLOCKED
  NDA_SIGNED
  CALL_BOOKED
  CALL_CANCELED
  CALL_COMPLETED
  EMAIL_OPENED
  LINK_CLICKED
}

enum BounceKind {
  HARD
  SOFT
  COMPLAINT
}

model EmailCampaign {
  id            String              @id @default(cuid())
  name          String
  status        EmailCampaignStatus @default(DRAFT)
  audience      String
  template      String
  dailyLimit    Int                 @default(2000)
  delayDays     Int                 @default(3)
  followUpCount Int                 @default(3)
  abTest        Boolean             @default(true)
  autoPause     Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Which mailbox this campaign sends through. Null = fall back to the
  // single global EMAIL_PROVIDER/.env-configured provider.
  emailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id])
  emailAccountId String?

  leads        EmailLead[]
  cadenceSteps CadenceStep[]

  @@index([status])
}

model EmailAccount {
  id         String  @id @default(cuid())
  label      String
  smtpHost   String
  smtpPort   Int
  smtpSecure Boolean @default(true)
  smtpUser   String
  // AES-256-GCM ciphertext (see src/lib/credentialCrypto.js), never the
  // plaintext password — decrypted in memory only at the moment of
  // building an SMTP transporter.
  smtpPassEncrypted String
  fromAddress       String
  dailyLimit        Int      @default(500)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // null = a shared/company mailbox (managed by an Admin, usable in any
  // campaign). Set = a personal mailbox owned by that employee — only they
  // (or an Admin) can see or edit it.
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String?

  campaigns EmailCampaign[]

  @@index([ownerId])
}

model CadenceStep {
  id           String        @id @default(cuid())
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId   String
  stepIndex    Int
  title        String
  bodyTemplate String
  delayDays    Int

  @@unique([campaignId, stepIndex])
}

model EmailLead {
  id           String    @id @default(cuid())
  name         String
  company      String
  email        String
  owner        String
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id])
  campaignId   String
  replyType    ReplyType @default(NO_REPLY)
  stage        String    @default("Reminder Pending")
  unsubscribed Boolean   @default(false)
  // A hard bounce or spam complaint suppresses this lead permanently; a
  // soft bounce (mailbox full, temp DNS failure) does not — see
  // src/routes/bounces.js.
  bounced    Boolean     @default(false)
  bounceKind BounceKind?
  // A lightweight "clickwrap" e-signature (typed name + IP + timestamp),
  // not a certified signature the way DocuSign/HelloSign produce one — see
  // routes/nda.js for what this actually captures and its limits.
  ndaSignedAt   DateTime?
  ndaSignedName String?
  ndaSignedIp   String?
  // Calendly tells you a meeting was booked (invitee.created) or canceled
  // (invitee.canceled) via webhook — it does NOT tell you whether anyone
  // actually showed up. callCompletedAt is a manual confirmation
  // (POST /email/leads/:id/mark-call-completed), not something Calendly reports.
  callBookedAt     DateTime?
  callScheduledFor DateTime?
  callCanceledAt   DateTime?
  callCompletedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  replyEvents      ReplyEvent[]
  activityLog      EmailActivityLog[]
  matchedBySignals MarketSignal[]     @relation("MarketSignalMatchedLead")
  createdBySignals MarketSignal[]     @relation("MarketSignalCreatedLead")

  @@index([campaignId])
  @@index([email])
}

model ReplyEvent {
  id          String    @id @default(cuid())
  lead        EmailLead @relation(fields: [leadId], references: [id])
  leadId      String
  rawBody     String
  matchedRule String?
  replyType   ReplyType
  receivedAt  DateTime  @default(now())
}

model EmailActivityLog {
  id        String            @id @default(cuid())
  lead      EmailLead         @relation(fields: [leadId], references: [id])
  leadId    String
  kind      EmailActivityKind
  title     String
  detail    String
  createdAt DateTime          @default(now())

  @@index([leadId, createdAt])
}

model EmailTemplate {
  id      String  @id @default(cuid())
  key     String  @unique
  subject String
  body    String
  // Optional branded HTML version. When null, the send path wraps `body`
  // in a default branded shell (see src/lib/renderTemplate.js) rather than
  // sending plain text with no company identity/unsubscribe link.
  html      String?
  updatedAt DateTime @updatedAt
}

enum SignalSource {
  NEWSAPI
  EXA
  FIRECRAWL
  // Google News RSS search feed — unlike the other three, needs no API key
  // or account, so it's the one source here that can produce real signals
  // without waiting on a credential. See sources/googleNewsRssSource.js.
  GOOGLE_NEWS
}

enum SignalType {
  FUNDING
  ACQUISITION
  EXPANSION
  LEADERSHIP_CHANGE
  DISTRESS
  OTHER
}

enum SignalStatus {
  PENDING // fetched, not yet AI-processed
  PROCESSED // AI-processed, routed (matched existing lead or created new one)
  DUPLICATE // matched contentHash of an already-seen signal, discarded
  IGNORED // processed but below relevance threshold / no entity match, no action taken
  FAILED // a source or AI-processing error stopped this signal short — see failureReason
}

// One row per raw item pulled from a source, carrying it through AI
// processing and routing. Matches against EmailLead.company free-text.
model MarketSignal {
  id             String       @id @default(cuid())
  source         SignalSource
  sourceUrl      String
  rawTitle       String
  rawContent     String
  rawPublishedAt DateTime?
  fetchedAt      DateTime     @default(now())

  // SHA-256 of source + normalized rawTitle, used for dedup (see
  // lib/marketIntelligence/dedup.js).
  contentHash String @unique

  status        SignalStatus @default(PENDING)
  failureReason String?

  // Filled in by AI processing (lib/marketIntelligence/aiProcessor.js) —
  // null until status moves past PENDING.
  entityName     String?
  signalType     SignalType?
  relevanceScore Int? // 0-100
  aiSummary      String?

  // Routing outcome: either an existing lead this signal updated, or a
  // newly-created one from an Apollo lookup — never both.
  matchedLeadId String?
  matchedLead   EmailLead? @relation("MarketSignalMatchedLead", fields: [matchedLeadId], references: [id])
  createdLeadId String?
  createdLead   EmailLead? @relation("MarketSignalCreatedLead", fields: [createdLeadId], references: [id])

  createdAt DateTime @default(now())

  @@index([status])
  @@index([entityName])
}
